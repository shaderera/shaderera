{
  "name": "shaderera-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter @shaderera/core --filter shaderera --filter create-shaderera build",
    "test": "node scripts/test-temp.ts pnpm -r --if-present test",
    "test:slow": "node scripts/test-temp.ts pnpm -r --if-present test:slow",
    "test:all": "node scripts/test-temp.ts pnpm -r --if-present test:all",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.13.6",
    "typescript": "6.0.3"
  }
}
