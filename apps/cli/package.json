{
  "name": "shaderera",
  "version": "0.2.1",
  "description": "Shaderera CLI and MCP: DevTools for programmable media that is deterministic in time.",
  "license": "MIT",
  "homepage": "https://github.com/shaderera/shaderera",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaderera/shaderera.git",
    "directory": "apps/cli"
  },
  "bugs": "https://github.com/shaderera/shaderera/issues",
  "type": "module",
  "bin": {
    "shaderera": "./bin/shaderera.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/fixtures",
    "docs",
    "guides",
    "shaderera.schema.json"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node scripts/docs.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:slow": "pnpm --filter @shaderera/core run build && pnpm run build && node --test \"src/**/*.it.ts\"",
    "test:all": "pnpm --filter @shaderera/core run build && pnpm run build && node --test \"src/**/*.test.ts\" \"src/**/*.it.ts\"",
    "build:wasm": "node scripts/image-wasm.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/canvas": "1.0.10",
    "@shaderera/core": "workspace:*",
    "comlink": "4.4.2",
    "diff": "8.0.4",
    "magic-string": "1.4.3",
    "mediabunny": "1.61.1",
    "minisearch": "7.2.0",
    "oxc-parser": "0.153.0",
    "wgpu-matrix": "3.4.2"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "fast-png": "8.0.0",
    "jpeg-js": "0.4.4",
    "vite": "8.3.5"
  }
}
