{
  "name": "@shaderera/registry",
  "version": "0.1.1",
  "description": "The Shaderera registry: search, add, eject and publish templates, extensions, components, presets and media, like npm for clips.",
  "license": "MIT",
  "homepage": "https://github.com/shaderera/shaderera",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaderera/shaderera.git",
    "directory": "apps/registry"
  },
  "bugs": "https://github.com/shaderera/shaderera/issues",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "bin": {
    "shaderera-registry": "./bin/shaderera-registry.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "minisearch": "7.2.0"
  }
}
